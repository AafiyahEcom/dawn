{%- style -%}
  /*
   * Dynamic values driven by schema settings — computed once per section render.
   * Everything that doesn't depend on Liquid lives in the <style> block below.
   */
  #bb-hero-{{ section.id }} {
    --bb-hero-min-height: {{ section.settings.min_height }};
    --bb-hero-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --bb-image-position: {{ section.settings.image_position }};
  }
{%- endstyle -%}

<style>
  /* ============================================================
     Section: bb-hero
     Full-width split-screen editorial hero
     ============================================================ */

  .bb-hero {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    position: relative;
  }

  /* ---- Text / content side --------------------------------- */
  .bb-hero__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    background-color: var(--bb-cream);
    padding: 5.6rem 2.8rem;
    order: 2; /* text below image on mobile */
  }

  .bb-hero__inner {
    max-width: 54rem; /* keeps line-lengths editorial, not stretched */
  }

  /* ---- Media / image side ---------------------------------- */
  .bb-hero__media {
    position: relative;
    overflow: hidden;
    order: 1; /* image on top on mobile */
    height: 50vw; /* as specified: 50vw height on mobile */
    flex-shrink: 0;
  }

  .bb-hero__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--bb-image-position, center center);
  }

  /* Placeholder SVG fills space when no image is set */
  .bb-hero__image--placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    background-color: var(--bb-blush);
  }

  .bb-hero__image--placeholder svg {
    width: 100%;
    height: 100%;
  }

  /* Warm terracotta tint over image */
  .bb-hero__overlay {
    position: absolute;
    inset: 0;
    background-color: var(--bb-terracotta);
    opacity: var(--bb-hero-overlay-opacity, 0.08);
    pointer-events: none;
    z-index: 1;
  }

  /* ---- Label ----------------------------------------------- */
  .bb-hero__label {
    display: block;
    font-family: var(--bb-font-body);
    font-size: 1.1rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--bb-terracotta);
    margin-bottom: 2.4rem;
  }

  /* ---- Heading --------------------------------------------- */
  .bb-hero__heading {
    font-family: var(--bb-font-heading);
    font-size: 3.8rem;
    font-weight: 300;
    letter-spacing: -0.02em;
    line-height: 1.08;
    color: var(--bb-charcoal);
    margin: 0 0 2.4rem;
  }

  /* ---- Subtext --------------------------------------------- */
  .bb-hero__subtext {
    font-family: var(--bb-font-body);
    font-size: 1.5rem;
    font-weight: 400;
    letter-spacing: 0.03em;
    line-height: 1.65;
    color: rgba(44, 44, 44, 0.55);
    margin: 0 0 4rem;
  }

  /* ---- CTA buttons ----------------------------------------- */
  .bb-hero__ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.6rem;
  }

  .bb-hero__btn {
    display: inline-block;
    font-family: var(--bb-font-body);
    font-size: 1.2rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 1.6rem 3.2rem;
    line-height: 1;
    white-space: nowrap;
    transition:
      background-color 220ms ease,
      color 220ms ease,
      border-color 220ms ease;
  }

  .bb-hero__btn--primary {
    background-color: var(--bb-terracotta);
    color: var(--bb-cream);
    border: 1px solid var(--bb-terracotta);
  }

  .bb-hero__btn--primary:hover {
    background-color: transparent;
    color: var(--bb-terracotta);
  }

  .bb-hero__btn--secondary {
    background-color: transparent;
    color: var(--bb-charcoal);
    border: 1px solid var(--bb-charcoal);
  }

  .bb-hero__btn--secondary:hover {
    background-color: var(--bb-charcoal);
    color: var(--bb-cream);
  }

  /* ---- Desktop: true 50 / 50 split ------------------------- */
  @media screen and (min-width: 750px) {
    .bb-hero {
      flex-direction: row;
      min-height: var(--bb-hero-min-height, 90vh);
    }

    .bb-hero__content {
      flex: 0 0 50%;
      order: 1;
      padding: 7.2rem 5.6rem 7.2rem 7.2rem;
    }

    .bb-hero__media {
      flex: 0 0 50%;
      order: 2;
      height: auto; /* fills the full row height on desktop */
      min-height: 100%;
    }
  }

  @media screen and (min-width: 990px) {
    .bb-hero__content {
      padding: 8rem 6.4rem 8rem 9.6rem;
    }

    .bb-hero__heading {
      font-size: clamp(4.4rem, 4.2vw, 6.4rem);
    }
  }

  @media screen and (min-width: 1200px) {
    .bb-hero__content {
      padding: 8rem 7.2rem 8rem min(12vw, 12rem);
    }
  }

  /* ============================================================
     Staggered fade-up entrance animation
     Order: label → heading → subtext → CTAs | image fades in
     ============================================================ */

  @keyframes bb-hero-fade-up {
    from {
      opacity: 0;
      transform: translateY(2.4rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes bb-hero-fade-in {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  .bb-hero__label {
    animation: bb-hero-fade-up 0.75s cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: 0.08s;
  }

  .bb-hero__heading {
    animation: bb-hero-fade-up 0.85s cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: 0.22s;
  }

  .bb-hero__subtext {
    animation: bb-hero-fade-up 0.75s cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: 0.38s;
  }

  .bb-hero__ctas {
    animation: bb-hero-fade-up 0.75s cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: 0.52s;
  }

  .bb-hero__media {
    animation: bb-hero-fade-in 1.2s ease both;
    animation-delay: 0.05s;
  }

  /* Respect the user's motion preference */
  @media (prefers-reduced-motion: reduce) {
    .bb-hero__label,
    .bb-hero__heading,
    .bb-hero__subtext,
    .bb-hero__ctas,
    .bb-hero__media {
      animation: none;
    }
  }
</style>

{%- liquid
  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif
  assign image_alt = section.settings.image.alt | default: section.settings.heading | default: shop.name | escape
-%}

<section
  id="bb-hero-{{ section.id }}"
  class="bb-hero"
  aria-label="{{ section.settings.heading | default: 'Hero' | escape }}"
>
  {%- comment -%} ── Left: editorial text ─────────────────────────────── {%- endcomment -%}
  <div class="bb-hero__content">
    <div class="bb-hero__inner">

      {%- if section.settings.label != blank -%}
        <span class="bb-hero__label">
          {{- section.settings.label -}}
        </span>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1 class="bb-hero__heading">
          {{- section.settings.heading -}}
        </h1>
      {%- endif -%}

      {%- if section.settings.subtext != blank -%}
        <p class="bb-hero__subtext">
          {{- section.settings.subtext -}}
        </p>
      {%- endif -%}

      {%- if section.settings.primary_button_label != blank
          or section.settings.secondary_button_label != blank -%}
        <div class="bb-hero__ctas">

          {%- if section.settings.primary_button_label != blank -%}
            <a
              href="{{ section.settings.primary_button_link | default: '#' }}"
              class="bb-hero__btn bb-hero__btn--primary"
            >
              {{- section.settings.primary_button_label -}}
            </a>
          {%- endif -%}

          {%- if section.settings.secondary_button_label != blank -%}
            <a
              href="{{ section.settings.secondary_button_link | default: '#' }}"
              class="bb-hero__btn bb-hero__btn--secondary"
            >
              {{- section.settings.secondary_button_label -}}
            </a>
          {%- endif -%}

        </div>
      {%- endif -%}

    </div>
  </div>

  {%- comment -%} ── Right: cover image ───────────────────────────────── {%- endcomment -%}
  <div class="bb-hero__media">

    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 1500
        | image_tag:
          class: 'bb-hero__image',
          alt: image_alt,
          loading: 'eager',
          fetchpriority: fetch_priority,
          widths: '550, 750, 1000, 1500',
          sizes: '(min-width: 750px) 50vw, 100vw'
      }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'bb-hero__image bb-hero__image--placeholder' }}
    {%- endif -%}

    <div class="bb-hero__overlay" aria-hidden="true"></div>

  </div>
</section>

{% schema %}
{
  "name": "BB Hero",
  "tag": "div",
  "class": "bb-hero-section",
  "settings": [
    {
      "type": "header",
      "content": "Text content"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Eyebrow label",
      "default": "New Collection",
      "info": "Short uppercase label above the headline — e.g. 'Spring 2025'"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Headline",
      "default": "Dress the body that's growing something beautiful."
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "Premium maternity and nursing wear, made to move with you."
    },
    {
      "type": "header",
      "content": "Primary button"
    },
    {
      "type": "text",
      "id": "primary_button_label",
      "label": "Label",
      "default": "Shop the Collection"
    },
    {
      "type": "url",
      "id": "primary_button_link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Secondary button"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "Label",
      "default": "Our Story"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image",
      "info": "Recommended: tall portrait crop, 1500 × 1800 px or larger"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Focal point",
      "options": [
        { "value": "top center",    "label": "Top"    },
        { "value": "center center", "label": "Centre" },
        { "value": "bottom center", "label": "Bottom" },
        { "value": "center left",   "label": "Left"   },
        { "value": "center right",  "label": "Right"  }
      ],
      "default": "center center"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "%",
      "label": "Warm overlay opacity",
      "default": 8,
      "info": "Terracotta tint over the image. 8% is subtle; raise for more warmth."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "min_height",
      "label": "Minimum height (desktop)",
      "options": [
        { "value": "70vh",  "label": "70vh" },
        { "value": "80vh",  "label": "80vh" },
        { "value": "90vh",  "label": "90vh — recommended" },
        { "value": "100vh", "label": "100vh — full screen" }
      ],
      "default": "90vh"
    }
  ],
  "presets": [
    {
      "name": "BB Hero"
    }
  ]
}
{% endschema %}
